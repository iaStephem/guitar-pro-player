{
  "name": "guitar-pro-player",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "pnpm run build && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "ru.ilya.guitarproplayer",
    "productName": "Guitar Pro Player",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release-1.0.2"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "fileAssociations": [
      {
        "ext": ["gp", "gp3", "gp4", "gp5", "gp6", "gp7", "gpx"],
        "name": "Guitar Pro score",
        "description": "Guitar Pro score",
        "role": "Editor"
      }
    ]
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.8.4",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4"
  }
}
